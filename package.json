{
  "name": "ludys-app-reconstructed",
  "version": "0.14.0-reconstructed.9",
  "private": true,
  "description": "Controlled LUDYS reconstruction baseline derived from the verified WP13.4 source proof.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "lint": "node scripts/static-check.mjs",
    "architecture": "node scripts/architecture-check.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "test:compiled": "node scripts/run-tests.mjs",
    "test": "npm run build && npm run test:compiled",
    "check": "npm run reconstruction && npm run lint && npm run architecture && npm run secret:scan && npm run build && npm run test:compiled && npm run operations:validate:compiled && npm run provider:decision:validate:compiled && npm run staging:validate:compiled && npm run test:browser-resolver && npm run test:browser-cleanup && npm run test:pwa-contract && npm run test:browser && npm run test:knowledge-browser && npm run test:readiness-browser && npm run test:lifecycle-browser && npm run test:app-browser && npm run test:pwa-browser && npm run test:corpus-browser && npm run test:authoring-browser && npm run test:operations-browser && npm run test:provider-decision-browser",
    "serve:proof": "node scripts/serve-proof.mjs",
    "test:browser": "node scripts/browser-accessibility-test.mjs",
    "test:browser-resolver": "node scripts/browser-executable-test.mjs",
    "test:browser-cleanup": "node --test scripts/browser-cleanup-test.mjs",
    "test:pwa-contract": "node --test scripts/pwa-contract-test.mjs",
    "test:pwa-browser": "node scripts/browser-pwa-offline-test.mjs",
    "test:corpus-browser": "node scripts/browser-draft-corpus-test.mjs",
    "test:authoring-browser": "node scripts/browser-authoring-pipeline-test.mjs",
    "test:operations-browser": "node scripts/browser-operations-kit-test.mjs",
    "test:provider-decision-browser": "node scripts/browser-provider-decision-test.mjs",
    "test:staging-browser": "node scripts/browser-wp13-12b-staging-test.mjs",
    "test:release-browser": "node scripts/browser-release-hardening-test.mjs",
    "test:wp13-10": "node --test dist/tests/properties/reliability-hardening.test.js dist/tests/properties/release-rollback.test.js dist/tests/scenarios/recovery-hardening.test.js dist/tests/scenarios/reliable-lifecycle-controller.test.js",
    "test:wp13-11": "node --test dist/tests/content/beta-operations-kit.test.js dist/tests/properties/beta-operations-validation.test.js dist/tests/scenarios/beta-operations-controller.test.js",
    "test:wp13-12a": "node --test dist/tests/content/provider-decision-package.test.js dist/tests/properties/provider-decision-validation.test.js dist/tests/scenarios/provider-decision-controller.test.js",
    "test:wp13-12b": "node --test dist/tests/properties/synthetic-staging-domain.test.js dist/tests/properties/staging-validation.test.js dist/tests/scenarios/firebase-authoritative-handler.test.js",
    "operations:generate": "node scripts/generate-wp13-11-operations.mjs",
    "operations:generate:check": "node scripts/generate-wp13-11-operations.mjs --check",
    "operations:validate:compiled": "node scripts/validate-wp13-11-operations.mjs",
    "operations:validate": "npm run build && npm run operations:validate:compiled",
    "provider:decision:generate": "node scripts/generate-wp13-12a-decision.mjs",
    "provider:decision:generate:check": "node scripts/generate-wp13-12a-decision.mjs --check",
    "provider:decision:validate:compiled": "node scripts/validate-wp13-12a-decision.mjs",
    "provider:decision:validate": "npm run build && npm run provider:decision:validate:compiled",
    "staging:generate": "node scripts/generate-wp13-12b-staging.mjs",
    "staging:generate:check": "node scripts/generate-wp13-12b-staging.mjs --check",
    "staging:validate:compiled": "node scripts/validate-wp13-12b-staging.mjs",
    "staging:validate": "npm run build && npm run staging:validate:compiled",
    "provider:package": "node scripts/build-wp13-12b-provider-package.mjs",
    "provider:cloud:preflight": "node scripts/provider-cloud-preflight.mjs",
    "provider:supply-chain:generate": "node scripts/generate-provider-supply-chain.mjs",
    "provider:supply-chain:check": "node scripts/provider-supply-chain-check.mjs",
    "test:provider-runtime": "node scripts/provider-functions-runtime-test.mjs",
    "provider:emulator:import": "node scripts/emulator-import-wp13-12b.mjs",
    "provider:emulator:proof": "node scripts/run-wp13-12b-emulator-proof.mjs",
    "provider:emulator:classify": "node scripts/classify-emulator-wp13-12b.mjs",
    "test:emulator-contract": "node scripts/emulator-contract-test.mjs",
    "receipt:validate": "node scripts/validate-wp13-12b-receipt.mjs",
    "preview:staging:build": "node scripts/build-wp13-12b-preview.mjs",
    "test:security-release": "node scripts/release-hardening-check.mjs",
    "test:performance": "node scripts/performance-budget-check.mjs",
    "test:reproducible-build": "node scripts/reproducible-build-test.mjs",
    "test:reproducible-build:write": "node scripts/reproducible-build-test.mjs --write-evidence",
    "release:metadata": "npm run provider:decision:generate:check && npm run staging:generate:check",
    "audit:production": "npm audit --omit=dev",
    "check:release": "npm run check && npm run test:wp13-10 && npm run test:wp13-11 && npm run test:wp13-12a && npm run test:wp13-12b && npm run provider:package && npm run preview:staging:build && npm run test:emulator-contract && npm run provider:emulator:classify && npm run test:provider-runtime && npm run test:staging-browser && npm run provider:cloud:preflight && npm run provider:supply-chain:check && npm run test:security-release && npm run test:performance && npm run test:release-browser && npm run test:reproducible-build && npm run release:metadata && npm run staging:validate:compiled && npm run audit:production",
    "test:knowledge-browser": "node scripts/browser-knowledge-test.mjs",
    "test:readiness-browser": "node scripts/browser-readiness-test.mjs",
    "test:lifecycle-browser": "node scripts/browser-session-lifecycle-test.mjs",
    "test:app-browser": "node scripts/browser-full-app-navigation-test.mjs",
    "reconstruction": "node scripts/reconstruction-check.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  }
}
